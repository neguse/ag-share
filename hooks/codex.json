{
  "description": "ag-share: forward this session to a team chat thread (opt-in per session).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" hook-prompt --agent codex",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" hook-stop --agent codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
